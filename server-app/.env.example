PORT=4000
CLIENT_URL=http://localhost:5180
DATABASE_URL="file:./data/urithi.db"
STORAGE_DIR=./storage
BACKUP_DIR=./backups
# BACKUP_MIRROR_DIR=/Volumes/DisqueExterne/urithi-backups
AUTO_BACKUP_HOURS=24
MAX_UPLOAD_MB=2048
# CLAMSCAN_PATH=/opt/homebrew/bin/clamscan
# Jetons d'accès des applications de collecte (voir docs/API_COLLECTEUR.md)
# API_TOKEN_DAYS=30
# Applications web externes autorisées (CORS), séparées par des virgules
# API_ALLOWED_ORIGINS=https://collecte.exemple.cd
